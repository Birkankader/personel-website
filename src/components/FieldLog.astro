---
// Twelve months of commits drawn as an elevation profile: public work is solid ground, private
// work is hatched. Paths are computed here at build time from src/data/github.json; two SVGs
// (desktop and phone aspect ratios) keep the hatching undistorted.
import { ui, site, type Lang } from '../data/site';
import Caps from './Caps.astro';
import { github, tools, formatDate, formatMonth, formatNumber, messageLang } from '../data/github';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].log;

const weeks = github.weeks;
const n = weeks.length;
const ceiling = Math.ceil(Math.max(...weeks.map((w) => w.public + w.private)) / 50) * 50;
const f = (v: number) => Math.round(v * 10) / 10;

// Monotone cubic (Fritsch and Carlson): smooth, but never dips below the data.
function curve(xs: number[], ys: number[]) {
  const k = xs.length;
  const m: number[] = [];
  for (let i = 0; i < k - 1; i++) m.push((ys[i + 1] - ys[i]) / (xs[i + 1] - xs[i]));
  const tan = ys.map((_, i) => (i === 0 ? m[0] : i === k - 1 ? m[k - 2] : m[i - 1] * m[i] <= 0 ? 0 : (m[i - 1] + m[i]) / 2));
  for (let i = 0; i < k - 1; i++) {
    if (m[i] === 0) { tan[i] = 0; tan[i + 1] = 0; continue; }
    const a = tan[i] / m[i], b = tan[i + 1] / m[i], s = a * a + b * b;
    if (s > 9) { const q = 3 / Math.sqrt(s); tan[i] = q * a * m[i]; tan[i + 1] = q * b * m[i]; }
  }
  let d = '';
  for (let i = 0; i < k - 1; i++) {
    const h = (xs[i + 1] - xs[i]) / 3;
    d += ` C${f(xs[i] + h)} ${f(ys[i] + tan[i] * h)} ${f(xs[i + 1] - h)} ${f(ys[i + 1] - tan[i + 1] * h)} ${f(xs[i + 1])} ${f(ys[i + 1])}`;
  }
  return d;
}

function profile(W: number, H: number) {
  const xs = weeks.map((_, i) => ((i + 0.5) / n) * W);
  const yPub = weeks.map((w) => H - (w.public / ceiling) * H);
  const yTot = weeks.map((w) => H - ((w.public + w.private) / ceiling) * H);
  const last = n - 1;
  const pub = `M0 ${H} L0 ${f(yPub[0])} L${f(xs[0])} ${f(yPub[0])}${curve(xs, yPub)} L${W} ${f(yPub[last])} L${W} ${H} Z`;
  const rx = [...xs].reverse(), ry = [...yPub].reverse();
  const priv = `M0 ${f(yTot[0])} L${f(xs[0])} ${f(yTot[0])}${curve(xs, yTot)} L${W} ${f(yTot[last])} L${W} ${f(yPub[last])} L${f(xs[last])} ${f(yPub[last])}${curve(rx, ry)} L0 ${f(yPub[0])} Z`;
  const edge = `M0 ${f(yTot[0])} L${f(xs[0])} ${f(yTot[0])}${curve(xs, yTot)} L${W} ${f(yTot[last])}`;
  const grid = [50, 100, 150].filter((v) => v < ceiling).map((v) => H - (v / ceiling) * H);
  return { pub, priv, edge, grid, W, H };
}
const desk = profile(1060, 300);
const phone = profile(360, 240);

// Numbered points: what I was building at that moment.
const marks = t.points.map((p, i) => {
  const idx = weeks.findIndex((w) => w.start === p.week);
  const w = weeks[idx];
  return { ...p, n: i + 1, left: ((idx + 0.5) / n) * 100, top: (1 - (w.public + w.private) / ceiling) * 100, stem: i % 2 ? 2.6 : 1.1 };
});

// Month ticks where a week starts a new month.
const ticks: { left: number; label: string; year?: number }[] = [];
weeks.forEach((w, i) => {
  const d = new Date(`${w.start}T12:00:00Z`);
  const prev = i ? new Date(`${weeks[i - 1].start}T12:00:00Z`) : null;
  if (!prev || prev.getUTCMonth() !== d.getUTCMonth()) {
    const m = d.getUTCMonth();
    ticks.push({ left: (i / n) * 100, label: t.months[m], year: m === 0 || !prev ? d.getUTCFullYear() : undefined });
  }
});
// The first week sits mid-month; start the labels at the first full month.
ticks.shift();

// Monthly totals for assistive tech.
const months = new Map<string, { label: string; pub: number; priv: number }>();
for (const w of weeks) {
  const d = new Date(`${w.start}T12:00:00Z`);
  const key = `${d.getUTCFullYear()}-${d.getUTCMonth()}`;
  const row = months.get(key) ?? { label: `${t.months[d.getUTCMonth()]} ${d.getUTCFullYear()}`, pub: 0, priv: 0 };
  row.pub += w.public;
  row.priv += w.private;
  months.set(key, row);
}
const pubLabel = lang === 'en' ? 'Public' : 'Açık';
const privLabel = lang === 'en' ? 'Private' : 'Gizli';
const monthLabel = lang === 'en' ? 'Month' : 'Ay';
---
<section class="log sec grid" id="field-log" aria-labelledby="log-title">
  <h2 class="log__title h-sec" id="log-title" data-split="lines">{t.title}</h2>
  <p class="log__lead lead">{t.lead(formatNumber(github.commits.total, lang))}</p>

  <figure class="log__figure" data-chart>
    <div class="chart" aria-hidden="true">
      {[{ p: desk, cls: 'chart__d', id: 'log-hatch-d' }, { p: phone, cls: 'chart__m', id: 'log-hatch-m' }].map(({ p, cls, id }) => (
        <svg class={cls} viewBox={`0 0 ${p.W} ${p.H}`} preserveAspectRatio="none" focusable="false">
          <defs>
            <pattern id={id} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="5" stroke="#0e110f" stroke-width="1.3" />
            </pattern>
          </defs>
          {p.grid.map((y) => <line class="chart__grid" x1="0" x2={p.W} y1={y} y2={y} />)}
          <path class="chart__pub" d={p.pub} data-chart-fill />
          <path d={p.priv} fill={`url(#${id})`} data-chart-fill />
          <path class="chart__edge" d={p.edge} data-chart-edge />
          <line class="chart__base" x1="0" x2={p.W} y1={p.H} y2={p.H} />
        </svg>
      ))}
      {marks.map((m) => (
        <span class="chart__mark" style={`left:${m.left}%;top:${m.top}%;--stem:${m.stem}rem`} data-chart-mark>
          <span class="chart__num">{m.n}</span>
          <span class="chart__stem"></span>
        </span>
      ))}
    </div>
    <div class="chart__months" aria-hidden="true">
      {ticks.map((tk) => <span style={`left:${tk.left}%`}>{tk.label}{tk.year && <> <b class="chart__yr">{tk.year}</b></>}</span>)}
    </div>
    <div class="chart__key" aria-hidden="true">
      <span><i class="key-pub"></i>{pubLabel}</span>
      <span><i class="key-priv"></i>{privLabel}</span>
    </div>
    <figcaption class="chart__cap">{t.caption(formatDate(github.generated, lang))}</figcaption>
    <div class="sr-only">
      <table>
        <caption>{t.chartLabel}</caption>
        <thead><tr><th scope="col">{monthLabel}</th><th scope="col">{pubLabel}</th><th scope="col">{privLabel}</th></tr></thead>
        <tbody>
          {[...months.values()].map((r) => <tr><th scope="row">{r.label}</th><td>{r.pub}</td><td>{r.priv}</td></tr>)}
        </tbody>
      </table>
    </div>
  </figure>

  <ol class="log__points" data-shy>
    {marks.map((m) => (
      <li><span><time datetime={m.week.slice(0, 7)}>{formatMonth(m.week, lang)}</time>{m.text}</span></li>
    ))}
  </ol>

  <div class="log__recent">
    <h3 class="label log__h"><Caps text={t.recentTitle} lang={lang} /></h3>
    <ul data-shy>
      {github.recent.map((c) => (
        <li class="commit">
          <a href={c.url} target="_blank" rel="noopener">
            <span class="commit__repo">{c.repo}<span class="link__out" aria-hidden="true">→</span></span>
            <span class="commit__msg" lang={messageLang(c.message) !== lang ? messageLang(c.message) : undefined}>{c.message}</span>
            <time class="commit__date" datetime={c.date}>{formatDate(c.date, lang)}</time>
            <span class="row__pt" aria-hidden="true"></span><span class="row__line" aria-hidden="true"></span><span class="row__end" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="log__also">
    <h3 class="label log__h"><Caps text={t.alsoTitle} lang={lang} /></h3>
    <ul data-shy>
      {tools.map((tl) => (
        <li class="tool">
          <a href={tl.href} target="_blank" rel="noopener">
            <span class="tool__name">{tl.name}<span class="link__out" aria-hidden="true">→</span></span>
            <span class="tool__text">{tl.text[lang]}</span>
            <span class="tool__lang">{tl.lang}</span>
            <span class="row__pt" aria-hidden="true"></span><span class="row__line" aria-hidden="true"></span><span class="row__end" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ul>
    <a class="btn log__profile" href={site.github} target="_blank" rel="me noopener">{t.profile}</a>
  </div>
</section>
