---
// WhaleCode's run, as the README describes it: a master agent splits the task, workers run in
// their own git worktrees and share one notes file, and a person approves before the merge.
import type { Lang } from '../../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = {
  en: { task: 'Your task', master: 'Master agent', split: 'splits it into subtasks', worker: 'Worker', tree: 'own git worktree', notes: 'Shared notes file', you: 'You approve', merge: 'Merge', label: 'Diagram: your task goes to a master agent, which splits it across three workers, each in its own git worktree. The workers share one notes file. You approve, then the work is merged.' },
  tr: { task: 'Göreviniz', master: 'Yönetici ajan', split: 'alt görevlere böler', worker: 'İşçi', tree: 'kendi git worktree’si', notes: 'Ortak not dosyası', you: 'Onayınız', merge: 'Birleştirme', label: 'Şema: göreviniz yönetici ajana gider; ajan onu her biri kendi git worktree’sinde çalışan üç işçiye böler. İşçiler tek bir not dosyasını paylaşır. Siz onaylarsınız, ardından iş birleştirilir.' },
}[lang];
const ys = [70, 150, 230];
// Phones get the same run turned upright: the worker column stays as it is, the task and master
// sit above it, the approval and merge below, so the type keeps its size.
const ms = [176, 248, 320];
---
<figure class="diagram">
  <svg class="diagram__m" viewBox="0 0 340 540" role="img" aria-label={t.label}>
    <g fill="none" stroke="#0e110f" stroke-width="1.25">
      <path d="M170 22 V48" />
      <path d="M170 104 V120 Q170 128 162 128 H48 Q40 128 40 136 V312 Q40 320 48 320 H80" />
      {ms.slice(0, 2).map((y) => <path d={`M40 ${y} H80`} />)}
      <path d="M260 176 H292 Q300 176 300 184 V416 Q300 424 292 424 H178 Q170 424 170 432 V437" />
      {ms.slice(1).map((y) => <path d={`M260 ${y} H300`} />)}
      {ms.map((y) => <path d={`M170 ${y + 26} V${y + 46}`} stroke-dasharray="2 4" />)}
      <path d="M170 467 V490" stroke="#2236f5" stroke-width="2" />
    </g>
    <circle cx="170" cy="16" r="6" fill="#0e110f" />
    <text x="184" y="21" font-size="13" font-weight="600">{t.task}</text>
    <rect x="80" y="48" width="180" height="56" fill="#eceee8" stroke="#0e110f" stroke-width="1.25" />
    <text x="94" y="72" font-size="15" font-weight="700">{t.master}</text>
    <text x="94" y="92" font-size="11.5" fill="#555b56">{t.split}</text>
    {ms.map((y, i) => (
      <g>
        <rect x="80" y={y - 26} width="180" height="52" fill="#eceee8" stroke="#0e110f" stroke-width="1.25" />
        <text x="94" y={y - 4} font-size="14" font-weight="700">{t.worker} {i + 1}</text>
        <text x="94" y={y + 14} font-size="11" fill="#555b56">{t.tree}</text>
      </g>
    ))}
    <rect x="80" y="366" width="180" height="34" fill="none" stroke="#0e110f" stroke-width="1.25" stroke-dasharray="4 3" />
    <text x="94" y="388" font-size="12" font-weight="600">{t.notes}</text>
    <circle cx="170" cy="452" r="15" fill="#eceee8" stroke="#2236f5" stroke-width="2" />
    <circle cx="170" cy="452" r="5" fill="#2236f5" />
    <text x="194" y="457" font-size="12.5" font-weight="600" fill="#2236f5">{t.you}</text>
    <rect x="125" y="490" width="90" height="40" fill="#0e110f" />
    <text x="170" y="515" font-size="13" font-weight="700" fill="#eceee8" text-anchor="middle">{t.merge}</text>
  </svg>
  <svg class="diagram__d" viewBox="0 0 680 340" role="img" aria-label={t.label}>
    <g fill="none" stroke="#0e110f" stroke-width="1.25">
      <path d="M38 150 H118" />
      {ys.map((y) => <path d={`M262 150 C300 150 300 ${y} 338 ${y}`} />)}
      {ys.map((y) => <path d={`M478 ${y} C512 ${y} 512 150 546 150`} />)}
      {ys.map((y) => <path d={`M408 ${y + 26} V${y + 34}`} stroke-dasharray="2 4" />)}
      <path d="M408 270 V292" stroke-dasharray="2 4" />
      <path d="M576 150 H604" stroke="#2236f5" stroke-width="2" />
    </g>
    <circle cx="34" cy="150" r="6" fill="#0e110f" />
    <text x="20" y="128" font-size="13" font-weight="600">{t.task}</text>
    <rect x="118" y="118" width="144" height="64" fill="#eceee8" stroke="#0e110f" stroke-width="1.25" />
    <text x="132" y="146" font-size="15" font-weight="700">{t.master}</text>
    <text x="132" y="166" font-size="11.5" fill="#555b56">{t.split}</text>
    {ys.map((y, i) => (
      <g>
        <rect x="338" y={y - 26} width="140" height="52" fill="#eceee8" stroke="#0e110f" stroke-width="1.25" />
        <text x="352" y={y - 4} font-size="14" font-weight="700">{t.worker} {i + 1}</text>
        <text x="352" y={y + 14} font-size="11" fill="#555b56">{t.tree}</text>
      </g>
    ))}
    <rect x="338" y="292" width="140" height="34" fill="none" stroke="#0e110f" stroke-width="1.25" stroke-dasharray="4 3" />
    <text x="352" y="314" font-size="12" font-weight="600">{t.notes}</text>
    <circle cx="561" cy="150" r="15" fill="#eceee8" stroke="#2236f5" stroke-width="2" />
    <circle cx="561" cy="150" r="5" fill="#2236f5" />
    <text x="530" y="194" font-size="12.5" font-weight="600" fill="#2236f5">{t.you}</text>
    <rect x="604" y="128" width="70" height="44" fill="#0e110f" />
    <text x="639" y="155" font-size="13" font-weight="700" fill="#eceee8" text-anchor="middle">{t.merge}</text>
  </svg>
</figure>
