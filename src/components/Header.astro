---
import { site, ui, localize, otherLangPath, type Lang } from '../data/site';
import type { Page } from '../layouts/Base.astro';
interface Props { lang: Lang; page: Page; path: string }
const { lang, page, path } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'tr' : 'en';
const switchHref = page === '404' ? localize(other, '/') : otherLangPath(path);
const links = [
  { key: 'work', label: t.nav.work, href: page === 'home' ? '#work' : localize(lang, '/#work'), current: page === 'work' ? 'true' : undefined },
  { key: 'about', label: t.nav.about, href: localize(lang, '/about/'), current: page === 'about' ? 'page' : undefined },
  { key: 'contact', label: t.nav.contact, href: localize(lang, '/contact/'), current: page === 'contact' ? 'page' : undefined },
];
---
<header class="header" data-header>
  <a class="wordmark" href={localize(lang, '/')} aria-label={`${site.name}, ${t.home}`}>
    <span class="wordmark__dot" aria-hidden="true"></span><span class="wordmark__name">{site.name}</span>
  </a>
  <nav class="nav" aria-label={t.nav.label}>
    <ul class="nav__list">
      {links.map((l) => (
        <li><a class="nav__link" href={l.href} data-nav={l.key} aria-current={l.current as 'page' | 'true' | undefined}><span class="nav__pt" aria-hidden="true"></span>{l.label}</a></li>
      ))}
    </ul>
    <a class="lang" href={switchHref} hreflang={other} lang={other} data-lang-switch={other}>{t.langSwitch.short}<span class="sr-only">, {t.langSwitch.label}</span></a>
  </nav>
</header>
