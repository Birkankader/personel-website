---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { ui, site, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].contact;
---
<Base lang={lang} page="contact" title={t.metaTitle} description={t.description}>
  <section class="contact__hero grid" data-map="full" aria-labelledby="contact-title">
    <h1 class="contact__title" id="contact-title" data-obstacle="glyphs">{t.title}</h1>
    <p class="contact__lead lead on-map" data-wash data-split="lines" data-intro data-delay="0.25">{t.lead}</p>
    <a class="contact__email" href={`mailto:${site.email}`} data-route-target data-reveal="fade" data-intro data-delay="0.45"><span class="cta-mega__pt" aria-hidden="true"></span><span>{site.email}</span></a>
    <p class="contact__where on-map" data-reveal="fade" data-intro data-delay="0.55">{t.location}</p>
  </section>
  <section class="form-sec grid" aria-labelledby="form-title">
    <h2 class="h-margin" id="form-title" data-split="lines" data-live>{t.form.title}</h2>
    <ContactForm lang={lang} />
  </section>
</Base>
